# Placeholder defaults so the frontend boots without external credentials.
# Real secrets (when provided) are delivered via /run/base44/app.env and override these.

# Manus OAuth — only needed when a user clicks "sign in"
VITE_APP_ID=local-dev
VITE_OAUTH_PORTAL_URL=https://oauth.example.com

# Stripe — only needed for checkout flows
VITE_STRIPE_PUBLISHABLE_KEY=

# Error reporting — optional monitoring
VITE_VLY_APP_ID=
VITE_VLY_MONITORING_URL=

# Server-side secrets (used only if the Express backend is run)
JWT_SECRET=local-dev-secret-not-for-production
DATABASE_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
